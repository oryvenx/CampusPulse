# ---- Runtime ----
APP_ENV=dev
AWS_REGION=us-east-1

# ---- Storage ----
EVENTS_TABLE=campuspulse-events
USERS_TABLE=campuspulse-users

# ---- Auth (Cognito) ----
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# ---- Secrets ----
# In AWS, this is fetched from Secrets Manager.
# Locally, you can set it directly.
JWT_SECRET=change-me-locally

# ---- Feature flags ----
# true  -> use moto/local mocks (offline dev)
# false -> use real AWS (DynamoDB, Cognito, etc.)
USE_LOCAL_DB=true